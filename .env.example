# Copy this file to .env before using Docker or local development.

# Server
HOST=127.0.0.1
PORT=8001
RELOAD=true

# Application
ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
DATABASE_URL=sqlite:///data/novelcast.db
LOG_LEVEL=info
LOG_FILE=logs/novelcast.log

# Administrator-only GitHub release notice (set empty to disable)
GITHUB_REPOSITORY=dr-fluff/novelcast

# BrowserSync development proxy
CORS_ORIGINS=["http://localhost:3000"]
