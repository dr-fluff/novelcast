# ─────────────────────────────
# ENVIRONMENT
# ─────────────────────────────
ENV=development
DEBUG=true

# ─────────────────────────────
# SERVER
# ─────────────────────────────
HOST=0.0.0.0
PORT=8001
RELOAD=true

# ─────────────────────────────
# DATABASE (bootstrap only)
# ─────────────────────────────
DATABASE_URL=sqlite:///data/novelcast.db

# ─────────────────────────────
# SECURITY
# ─────────────────────────────
SECRET_KEY=dev-secret-key-change-me-please-123456
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────
# LOGGING
# ─────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/novelcast.log

# ─────────────────────────────
# CORS (JSON format for Pydantic)
# ─────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]